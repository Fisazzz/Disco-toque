stylesheets/style.css
/_ STYLE: внешний вид (цвета, рамки, текст, анимации).
ИИ: Claude помог написать этот файл. Записи №1–№5 в README _/

/_ ---------- Переменные: палитра лежит в :root ---------- _/
:root {
--mint: #00ffc8;
--pink: #ff3bbd;
--blue: #435dff;
--yellow: #f7f700;
--purple: #935cfa;
--red: #ff0055;
--green: #00d800;
--orange: #ff8c00;
--warn: #ffc400;
--ink: #000;
--paper: #fff;
--metal: #a9acae;
}

/_ Цветовые классы: кладут нужный цвет в переменную --c _/
.c-mint { --c: var(--mint); }
.c-pink { --c: var(--pink); }
.c-blue { --c: var(--blue); }
.c-yellow { --c: var(--yellow); }
.c-purple { --c: var(--purple); }
.c-red { --c: var(--red); }
.c-green { --c: var(--green); }
.c-orange { --c: var(--orange); }

