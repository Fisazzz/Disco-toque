/_ ИИ: Claude придумал заполнение индикатора через прокрутку. Запись №5 в README _/
@keyframes charge {
from {
background: var(--paper);
box-shadow: none;
}
to {
background: var(--c);
box-shadow: 0 0 14px 3px var(--c);
}
}

/_ Основной способ: анимация привязана к прокрутке (animation-timeline).
Ячейки загораются, когда индикатор виден на экране, и каждый раз заново,
когда вы к нему возвращаетесь. Адрес страницы (#concept и т. п.) не важен. _/
@supports (animation-timeline: view()) {
.cell:nth-child(-n + 8) {
animation-name: charge;
animation-timing-function: linear;
animation-fill-mode: both;
animation-timeline: view();
}

/_ у каждой ячейки свой отрезок прокрутки: так они загораются по очереди _/
.cell:nth-child(1) { animation-range: cover 10% cover 35%; }
.cell:nth-child(2) { animation-range: cover 13% cover 38%; }
.cell:nth-child(3) { animation-range: cover 16% cover 41%; }
.cell:nth-child(4) { animation-range: cover 19% cover 44%; }
.cell:nth-child(5) { animation-range: cover 22% cover 47%; }
.cell:nth-child(6) { animation-range: cover 25% cover 50%; }
.cell:nth-child(7) { animation-range: cover 28% cover 53%; }
.cell:nth-child(8) { animation-range: cover 31% cover 56%; }
}

/_ Запасной способ для браузеров без animation-timeline:
заполняется, когда в адресе стоит #concept (переход по ссылке) _/
@supports not (animation-timeline: view()) {
#concept:target .cell:nth-child(-n + 8) {
animation: charge 0.3s both;
}

#concept:target .cell:nth-child(2) { animation-delay: 0.15s; }
#concept:target .cell:nth-child(3) { animation-delay: 0.3s; }
#concept:target .cell:nth-child(4) { animation-delay: 0.45s; }
#concept:target .cell:nth-child(5) { animation-delay: 0.6s; }
#concept:target .cell:nth-child(6) { animation-delay: 0.75s; }
#concept:target .cell:nth-child(7) { animation-delay: 0.9s; }
#concept:target .cell:nth-child(8) { animation-delay: 1.05s; }
}

